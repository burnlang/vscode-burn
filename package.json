{
  "name": "burn-language-server",
  "displayName": "Burn Language Support",
  "description": "Burn language support: diagnostics, completion, signature help, inlay type hints, hover, go to definition (also into the standard library and built-ins), find references, rename, formatting and quick fixes",
  "version": "26.3.0",
  "publisher": "burn",
  "icon": "images/icon.png",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/burnlang/vscode-burn"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:burn",
    "workspaceContains:**/burn.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "burn",
        "aliases": [
          "Burn",
          "burn"
        ],
        "extensions": [
          ".bn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "burn",
        "scopeName": "source.burn",
        "path": "./syntaxes/burn.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "burn",
        "path": "./snippets/burn.json"
      }
    ],
    "commands": [
      {
        "command": "burn.reloadProject",
        "title": "Burn: Reload Project (ash sync)",
        "icon": "$(sync)"
      },
      {
        "command": "burn.run",
        "title": "Burn: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "burn.runNative",
        "title": "Burn: Compile and Run Current File Natively"
      },
      {
        "command": "burn.build",
        "title": "Burn: Build Executable"
      },
      {
        "command": "burn.restartServer",
        "title": "Burn: Restart Language Server"
      },
      {
        "command": "burn.openStdlib",
        "title": "Burn: Open Standard Library Module..."
      },
      {
        "command": "burn.openBuiltins",
        "title": "Burn: Show Built-in Functions"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Burn",
      "properties": {
        "burn.path": {
          "type": "string",
          "default": "burn",
          "description": "Path to the burn executable used for the language server and commands. By default ~/.burn/bin/burn (installed by burnup) is used when it exists, otherwise burn from PATH."
        },
        "burn.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Burn language server."
        },
        "burn.codeLens.run": {
          "type": "boolean",
          "default": true,
          "description": "Show Run, Run natively and Build above `fun main()`."
        },
        "burn.ashPath": {
          "type": "string",
          "default": "ash",
          "description": "Path to the ash executable used to reload projects. By default ~/.burn/bin/ash (installed by burnup) is used when it exists, otherwise ash from PATH."
        },
        "burn.reload.onChange": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask whether to reload when burn.toml changes",
            "Reload automatically when burn.toml changes",
            "Never reload automatically; use Burn: Reload Project"
          ],
          "default": "ask",
          "description": "What to do when burn.toml changes: reload the project with ash sync, like a Gradle sync."
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "burn.run",
          "when": "resourceLangId == burn",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "burn.run",
          "when": "editorLangId == burn"
        },
        {
          "command": "burn.runNative",
          "when": "editorLangId == burn"
        },
        {
          "command": "burn.build",
          "when": "editorLangId == burn"
        }
      ],
      "editor/title": [
        {
          "command": "burn.reloadProject",
          "when": "resourceFilename == burn.toml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "burn.reloadProject",
          "when": "resourceFilename == burn.toml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretty": "prettier --write .",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.28.0"
  }
}
